{
  "name": "vscode-project-manager",
  "displayName": "Project Manager",
  "description": "Switch between projects.",
  "version": "2.0.0",
  "publisher": "WireCore",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "project",
    "folder",
    "workspace",
    "switch",
    "manage",
    "tree"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/WireCore/VS-Code-Project-Manager.git"
  },
  "activationEvents": [
    "onView:projectManagerTreeView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-project-manager.addProject",
        "title": "Add Project",
        "icon": "$(new-folder)"
      },
      {
        "command": "vscode-project-manager.addCategory",
        "title": "Add Category",
        "icon": "$(layers-dot)"
      },
      {
        "command": "vscode-project-manager.editEntry",
        "title": "Edit",
        "args": "item"
      },
      {
        "command": "vscode-project-manager.deleteEntry",
        "title": "Delete",
        "args": "item"
      },
      {
        "command": "vscode-project-manager.openInWindow",
        "title": "openInWindow",
        "args": "project"
      },
      {
        "command": "vscode-project-manager.openInNewWindow",
        "title": "Open In New Window",
        "args": "project",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vscode-project-manager.addProject",
          "when": "view == projectManagerTreeView",
          "group": "navigation"
        },
        {
          "command": "vscode-project-manager.addCategory",
          "when": "view == projectManagerTreeView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "vscode-project-manager.openInNewWindow",
          "when": "view == projectManagerTreeView && viewItem == TreeItemProject",
          "group": "inline"
        },
        {
          "command": "vscode-project-manager.editEntry",
          "when": "view == projectManagerTreeView"
        },
        {
          "command": "vscode-project-manager.deleteEntry",
          "when": "view == projectManagerTreeView"
        }
      ]
    },
    "views": {
      "wirecore-project-manager": [
        {
          "id": "projectManagerTreeView",
          "name": "projectManagerTreeView",
          "contextualTitle": "Project Manager"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wirecore-project-manager",
          "title": "Project Manager",
          "icon": "$(folder)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "~1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.12.0",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  }
}
